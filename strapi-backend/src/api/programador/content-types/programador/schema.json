{
  "kind": "collectionType",
  "collectionName": "programadores",
  "info": {
    "singularName": "programador",
    "pluralName": "programadores",
    "displayName": "Programador"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "slug": {
      "type": "uid",
      "targetField": "fullName",
      "required": true
    },
    "fullName": {
      "type": "string",
      "required": true
    },
    "role": {
      "type": "string",
      "required": true
    },
    "shortBio": {
      "type": "text"
    },
    "fullBio": {
      "type": "text"
    },
    "photoUrl": {
      "type": "string"
    },
    "email": {
      "type": "email",
      "required": true
    },
    "github": {
      "type": "string"
    },
    "linkedin": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "proyectos": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::proyecto.proyecto",
      "inversedBy": "programadores"
    }
  }
}
