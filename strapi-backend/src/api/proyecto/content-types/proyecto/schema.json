{
  "kind": "collectionType",
  "collectionName": "proyectos",
  "info": {
    "singularName": "proyecto",
    "pluralName": "proyectos",
    "displayName": "Proyecto"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "name": {
      "type": "string",
      "required": true
    },
    "shortDescription": {
      "type": "text"
    },
    "fullDescription": {
      "type": "text"
    },
    "imageUrl": {
      "type": "string"
    },
    "type": {
      "type": "enumeration",
      "enum": ["academico", "personal", "laboral", "simulado"],
      "default": "personal"
    },
    "technologies": {
      "type": "json"
    },
    "repoUrl": {
      "type": "string"
    },
    "demoUrl": {
      "type": "string"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "programadores": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::programador.programador",
      "mappedBy": "proyectos"
    }
  }
}
